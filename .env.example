# Copy to .env.local (local) or add in your hosting dashboard (Vercel / Cloudflare Pages).
# All values are public (NEXT_PUBLIC_*) and baked in at build time — never put secrets here.

# Canonical URL of the live site (used for SEO, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://versiert.in

# OPTIONAL — contact form backend. Leave empty to use the mailto: fallback.
# Option A: Formspree (free tier) → create a form at formspree.io and paste its endpoint:
#   NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxx
# Option B: Web3Forms (free tier) → get an access key at web3forms.com
#   (Web3Forms access keys are designed to be public):
#   NEXT_PUBLIC_WEB3FORMS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_FORM_ENDPOINT=
NEXT_PUBLIC_WEB3FORMS_KEY=
