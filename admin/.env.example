# ── Admin app configuration (set these in Vercel → versiert-admin → Settings → Environment Variables)

# GitHub OAuth app (github.com/settings/developers → New OAuth App)
#   Homepage URL:  https://admin.versiert.in
#   Callback URL:  https://admin.versiert.in/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Only these GitHub usernames may sign in (comma-separated).
ADMIN_GITHUB_LOGINS=Abhiramjayan-versiert

# Random string, 32+ characters. Encrypts the login cookie.
SESSION_SECRET=

# Website content lives here. Saving commits to this branch; Vercel then republishes versiert.in.
GITHUB_REPO=Abhiramjayan-versiert/Versiert-Website
GITHUB_BRANCH=claude/versiert-media-website-xqhnbl

# SaaS directory lives in a PRIVATE repo (the admin refuses to save it to a public one).
SAAS_REPO=Abhiramjayan-versiert/versiert-admin-data
SAAS_PATH=saas-apps.json

# Public website address (for "View site" links).
SITE_URL=https://versiert.in

# ── Local development only ─────────────────────────────────────────────
# CONTENT_BACKEND=local reads/writes ../content and ../public directly (no GitHub).
# ADMIN_DEV_LOGIN=1 shows a "Dev sign-in" button. Both are ignored in production.
# CONTENT_BACKEND=local
# ADMIN_DEV_LOGIN=1
